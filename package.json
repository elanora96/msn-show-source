{
  "name": "msn-show-source",
  "version": "1.0.3",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -b && node ./dist/src/addMetaData.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elanora96/msn-show-source.git"
  },
  "keywords": ["userscript", "typescript"],
